{
  "name": "astroscope",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:coverage": "rm -rf .coverage/v8 && E2E_COVERAGE=1 vitest run --coverage; status=$?; pnpm coverage; exit $status",
    "coverage": "pnpm --filter scripts coverage",
    "bench": "pnpm --filter benchmarks micro",
    "bench:macro": "pnpm --filter benchmarks macro",
    "validate": "turbo run test lint typecheck",
    "dev": "pnpm --filter demo-i18n dev",
    "ci:version": "changeset version && pnpm install --no-frozen-lockfile",
    "ci:publish": "changeset publish"
  },
  "devDependencies": {
    "@astroscope/eslint-plugin": "workspace:*",
    "@changesets/cli": "^3.0.3",
    "@entwico/eslint-config": "^8.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.10",
    "@vitest/coverage-v8": "^5.1.1",
    "astro": "^7.4.13",
    "daisyui": "^5.8.2",
    "eslint": "^10.15.0",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "turbo": "^2.11.13",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
