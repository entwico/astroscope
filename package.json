{
  "name": "astroscope",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "pnpm --filter benchmarks micro",
    "bench:macro": "pnpm --filter benchmarks macro",
    "validate": "turbo run test lint typecheck",
    "dev": "pnpm --filter demo-i18n dev",
    "ci:version": "changeset version && pnpm install --no-frozen-lockfile",
    "ci:publish": "changeset publish"
  },
  "devDependencies": {
    "@astroscope/eslint-plugin": "workspace:*",
    "@changesets/cli": "^3.0.3",
    "@entwico/eslint-config": "^5.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "astro": "^7.3.7",
    "daisyui": "^5.7.47",
    "eslint": "^10.12.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
