---
import JsonScript from './JsonScript.astro';

interface Props {
  /** A schema.org `Thing`, or an array of them. */
  content: unknown | unknown[];
}

const graph = [Astro.props.content].flat().filter((thing) => thing !== undefined);
---

<JsonScript type="application/ld+json" data={{ '@context': 'https://schema.org', '@graph': graph }} />
