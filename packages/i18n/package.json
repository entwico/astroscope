{
  "name": "@astroscope/i18n",
  "version": "1.1.2",
  "description": "i18n for Astro + React islands - MessageFormat 2, automatic tree-shaking, parallel loading, any translation source",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./translate": {
      "types": "./dist/client/translate.d.ts",
      "browser": "./dist/client/translate.js",
      "default": "./dist/server/translate.js"
    },
    "./chunk-middleware": {
      "types": "./dist/server/chunk-middleware-entrypoint.d.ts",
      "import": "./dist/server/chunk-middleware-entrypoint.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./extraction": {
      "types": "./dist/extraction/index.d.ts",
      "import": "./dist/extraction/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/chunk-*.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/entwico/astroscope",
    "directory": "packages/i18n"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "i18n",
    "internationalization",
    "translations",
    "messageformat",
    "mf2",
    "react",
    "islands",
    "ssr"
  ],
  "author": "admin@entwico.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/entwico/astroscope/issues"
  },
  "homepage": "https://github.com/entwico/astroscope/tree/main/packages/i18n#readme",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --cache",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@astrojs/compiler": "^4.0.0",
    "@babel/core": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@jridgewell/trace-mapping": "^0.3.31",
    "magic-string": "^1.2.2",
    "messageformat": "^4.0.0"
  },
  "devDependencies": {
    "@astroscope/node": "workspace:^",
    "@babel/types": "^8.0.4",
    "@types/babel__core": "^7.20.5",
    "astro": "^7.2.6",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "@astroscope/node": "workspace:^",
    "astro": "^7.0.0",
    "vite": "^8.0.0"
  }
}
