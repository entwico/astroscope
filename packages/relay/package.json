{
  "name": "@astroscope/relay",
  "version": "1.0.1",
  "description": "Consent-aware event relay for Astro",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./track": {
      "types": "./dist/server/track.d.ts",
      "browser": "./dist/client/track.js",
      "default": "./dist/server/track.js"
    },
    "./registry": {
      "types": "./dist/server/registry.d.ts",
      "import": "./dist/server/registry.js"
    },
    "./middleware": {
      "types": "./dist/server/middleware-entrypoint.d.ts",
      "import": "./dist/server/middleware-entrypoint.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./astro": {
      "import": "./src/astro/index.ts"
    },
    "./ga4": {
      "types": "./dist/ga4/index.d.ts",
      "import": "./dist/ga4/index.js"
    },
    "./gtm": {
      "types": "./dist/gtm/index.d.ts",
      "import": "./dist/gtm/index.js"
    },
    "./matomo": {
      "types": "./dist/matomo/index.d.ts",
      "import": "./dist/matomo/index.js"
    },
    "./ccm19": {
      "types": "./dist/ccm19/index.d.ts",
      "import": "./dist/ccm19/index.js"
    },
    "./awin": {
      "types": "./dist/awin/index.d.ts",
      "import": "./dist/awin/index.js"
    },
    "./openai": {
      "types": "./dist/openai/index.d.ts",
      "import": "./dist/openai/index.js"
    },
    "./openai/server": {
      "types": "./dist/openai/server.d.ts",
      "import": "./dist/openai/server.js"
    },
    "./meta": {
      "types": "./dist/meta/index.d.ts",
      "import": "./dist/meta/index.js"
    },
    "./meta/server": {
      "types": "./dist/meta/server.d.ts",
      "import": "./dist/meta/server.js"
    }
  },
  "files": [
    "dist",
    "src/astro"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/entwico/astroscope",
    "directory": "packages/relay"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "analytics",
    "consent",
    "tracking",
    "ga4",
    "awin",
    "meta",
    "ccm19",
    "matomo",
    "conversions",
    "actions",
    "gtm",
    "middleware"
  ],
  "author": "admin@entwico.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/entwico/astroscope/issues"
  },
  "homepage": "https://github.com/entwico/astroscope/tree/main/packages/relay#readme",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --cache",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@entwico/dash": "^1.3.0"
  },
  "devDependencies": {
    "@astroscope/node": "workspace:^",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "astro": "^7.4.4",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "tsdown": "^0.23.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@astroscope/node": "workspace:^",
    "astro": "^7.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
